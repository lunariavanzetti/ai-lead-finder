# Google Cloud project with "Places API" enabled + billing configured.
# https://console.cloud.google.com/google/maps-apis/api-list
GOOGLE_PLACES_API_KEY=

# Optional supplemental discovery — Programmable Search Engine (cx) configured
# to search the entire web, plus a Custom Search JSON API key.
# https://programmablesearchengine.google.com/
GOOGLE_CUSTOM_SEARCH_API_KEY=
GOOGLE_CUSTOM_SEARCH_CX=

ENVIRONMENT=development
RESPECT_ROBOTS_TXT=true
EXCLUDE_PERSONAL_DATA_EU=true
USER_AGENT=AILeadFinderBot/1.0 (+contact: you@example.com)
